# ===== Development database and cache =====
# Never point local tests or smoke runs at the production ALFA database.
DATABASE_URL=postgresql://user:password@localhost:5432/alfa_local
# Set only to a disposable loopback database when running smoke:discovery; this is not a DATABASE_URL fallback.
ALFA_SMOKE_DATABASE_URL=
REDIS_URL=redis://redis-host:6379/2

# ===== LLM orquestador =====
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=z-ai/glm-4.6

# Required discovery trust boundary values. Generate separate credentials for deployment;
# these values are non-working placeholders and must never be used as live secrets.
DASHBOARD_ORCHESTRATOR_TOKEN=REPLACE_WITH_DASHBOARD_TO_ORCHESTRATOR_CREDENTIAL
ORCHESTRATOR_PRODUCT_TOKEN=REPLACE_WITH_ORCHESTRATOR_TO_PRODUCT_CREDENTIAL
ALFA_TENANT_ID=00000000-0000-4000-8000-000000000001

# ===== LLM copywriting (puede ser el mismo u otro más barato) =====
LLM_MODEL_COPY=z-ai/glm-4.6

# ===== Dropi (cuenta real en app.dropi.cl) =====
DROPI_EMAIL=
DROPI_PASSWORD=

# ===== Meta Ad Library (saturación de anuncios) =====
META_AD_LIBRARY_TOKEN=

# ===== Proveedor de generación de imagen (API directa) =====
IMAGE_PROVIDER_API_KEY=
IMAGE_PROVIDER_BASE_URL=https://api.bfl.ml/v1
ASSET_STORAGE_PATH=/data/assets
ASSET_PUBLIC_BASE_URL=https://assets.aicorebots.com

# ===== Shopify =====
SHOPIFY_SHOP_DOMAIN=tu-tienda.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=
SHOPIFY_API_VERSION=2025-01
SHOPIFY_WEBHOOK_SECRET=

# ===== Meta (RRSS orgánico + Ads) =====
META_PAGE_ACCESS_TOKEN=
META_IG_BUSINESS_ACCOUNT_ID=
META_MARKETING_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# ===== TikTok (RRSS orgánico + Ads) =====
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# ===== Motor de auto-optimización =====
ROAS_PAUSE_THRESHOLD=1.2
INTERNAL_AUTOMATION_TOKEN=

# ===== Dashboard =====
NEXTAUTH_URL=https://dashboard.alfa.aicorebots.com
NEXTAUTH_SECRET=
DASHBOARD_ADMIN_EMAIL=
DASHBOARD_ADMIN_PASSWORD_HASH=
